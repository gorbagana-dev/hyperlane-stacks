apiVersion: batch/v1
kind: Job
metadata:
  name: "{{ job_name }}"
  namespace: "{{ namespace }}"
  labels:
    app.kubernetes.io/name: hyperlane-svm-ops
    app.kubernetes.io/component: verify-ownership
spec:
  backoffLimit: 0
  template:
    spec:
      restartPolicy: Never
      containers:
        - name: verify-ownership
          image: "{{ image }}"
          command: ["/bin/bash", "/opt/scripts/verify-ownership.sh"]
          env:
            - name: GORCHAIN_RPC_URL
              value: "{{ gorchain_rpc_url }}"
            - name: SOLANA_RPC_URL
              value: "{{ solana_rpc_url }}"
            - name: HARDWARE_WALLET_PUBKEY
              value: "{{ hardware_wallet_pubkey }}"
            - name: IGP_ORACLE_PUBKEY
              value: "{{ igp_oracle_pubkey }}"
          volumeMounts:
            - name: program-ids
              mountPath: /config/program-ids
              readOnly: true
            - name: scripts
              mountPath: /opt/scripts
              readOnly: true
      volumes:
        - name: program-ids
          configMap:
            name: hyperlane-program-ids
        - name: scripts
          configMap:
            name: "{{ script_configmap_name }}"
