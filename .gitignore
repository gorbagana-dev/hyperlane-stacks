__pycache__/
node_modules/
.data/
.deployments
.logs
.keys
# Solana keypairs are private keys — never commit (e.g. a deployer-keypair.json
# left in the tree from a manual deploy/test).
*-keypair.json
.venv/
.backpack-ext/
ops/collections/

# ops: per-env operator config + generated secrets (never commit).
# secrets.yml is the pre-rename name — keep ignoring operators' existing files.
ops/inventories/*/deployment-config.yml
ops/inventories/*/secrets.yml
