#!/usr/bin/env bash
# Pre-commit hook: run ruff linter when Python test code changes
#
# Setup: git config core.hooksPath .githooks

staged_py=$(git diff --cached --name-only --diff-filter=ACM -- 'tests/**/*.py')

if [ -z "$staged_py" ]; then
    exit 0
fi

if ! command -v ruff &>/dev/null; then
    echo "pre-commit: ruff not found, skipping lint"
    exit 0
fi

echo "pre-commit: running ruff on staged test files..."
ruff check $staged_py
