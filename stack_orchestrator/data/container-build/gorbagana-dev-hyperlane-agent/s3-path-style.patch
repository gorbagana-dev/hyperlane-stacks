+    /// Build an S3 client with custom endpoint and path-style support.
+    /// aws-config 1.1.7 does NOT read AWS_ENDPOINT_URL / AWS_ENDPOINT_URL_S3
+    /// from the environment, so we must set the endpoint programmatically.
+    /// S3-compatible stores like MinIO also require path-style addressing
+    /// because virtual-hosted-style (bucket.host) needs wildcard DNS.
+    fn build_s3_client(config: &aws_config::SdkConfig) -> Client {
+        let endpoint = std::env::var("AWS_ENDPOINT_URL_S3")
+            .or_else(|_| std::env::var("AWS_ENDPOINT_URL"))
+            .ok();
+
+        if let Some(endpoint_url) = endpoint {
+            let s3_config = aws_sdk_s3::config::Builder::from(config)
+                .endpoint_url(endpoint_url)
+                .force_path_style(true)
+                .build();
+            Client::from_conf(s3_config)
+        } else {
+            Client::new(config)
+        }
+    }
