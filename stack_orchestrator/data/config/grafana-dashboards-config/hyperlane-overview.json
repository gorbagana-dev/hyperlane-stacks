{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "title": "Validator Checkpoint Index",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "hyperlane_latest_checkpoint{phase=\"validator_processed\"}",
          "legendFormat": "{{ chain }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "title": "Relayer Messages Processed",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "rate(hyperlane_operations_processed_count[5m])",
          "legendFormat": "{{ chain }} - {{ phase }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      }
    },
    {
      "title": "Agent Pod Restarts",
      "description": "Requires kube-state-metrics to be deployed",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "increase(kube_pod_container_status_restarts_total{pod=~\".*hyperlane.*\"}[1h])",
          "legendFormat": "{{ pod }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          }
        }
      }
    }
  ],
  "schemaVersion": 39,
  "tags": ["hyperlane", "bridge"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "title": "Hyperlane Bridge Overview",
  "uid": "hyperlane-overview"
}
